


import pandas as pd
import numpy as np

rent = pd.read_csv('../data/interim/sj_rent_monthly.csv')
home_price = pd.read_csv('../data/interim/sj_home_prices_monthly.csv')





sj_rent = rent[
    (rent["RegionName"] == "San Jose, CA") &
    (rent["RegionType"] == "msa")
].copy()

sj_rent.shape



sj_home = home_price[
    (home_price["RegionName"] == "San Jose, CA") &
    (home_price["RegionType"] == "msa")
].copy()

sj_home






meta_cols = ["RegionID", "SizeRank", "RegionName", "RegionType", "StateName"]
date_cols = [c for c in sj_rent.columns if c not in meta_cols]
sj_rent_long = sj_rent.melt(
    id_vars=meta_cols,
    value_vars=date_cols,
    var_name="date",
    value_name="rent"
)

sj_rent_long["date"] = pd.to_datetime(sj_rent_long["date"])
sj_rent_long = sj_rent_long.sort_values("date").reset_index(drop=True)

sj_rent_long.head()



date_cols_home = [c for c in sj_home.columns if c not in meta_cols]

sj_home_long = sj_home.melt(
    id_vars=meta_cols,
    value_vars=date_cols_home,
    var_name="date",
    value_name="home_price"
)

sj_home_long["date"] = pd.to_datetime(sj_home_long["date"])
sj_home_long = sj_home_long.sort_values("date").reset_index(drop=True)

sj_rent_long


sj_housing = pd.merge(
    sj_rent_long[["date", "rent"]],
    sj_home_long[["date", "home_price"]],
    on="date",
    how="inner"
)

sj_housing.head()





sj_housing.isna().sum()


sj_housing["home_price"] = sj_housing["home_price"].interpolate()
sj_housing.isna().sum()


income = pd.read_csv("../data/interim/income_b19013_scc_annual.csv")
sj_housing["date"] = pd.to_datetime(sj_housing["date"])
sj_housing["year"] = sj_housing["date"].dt.year
income_small = income[["year", "median_household_income"]].copy()
sj_housing = pd.merge(
    sj_housing,
    income_small,
    on="year",
    how="left"
)
sj_housing['HPI'] = sj_housing['home_price'] / sj_housing['median_household_income']
sj_housing['rent_burden'] = (sj_housing['rent'] * 12) / sj_housing['median_household_income']
sj_housing["rent_yoy"]  = sj_housing["rent"].pct_change(12, fill_method=None)
sj_housing["price_yoy"] = sj_housing["home_price"].pct_change(12, fill_method=None)
sj_housing["HPI_yoy"]   = sj_housing["HPI"].pct_change(12, fill_method=None)
sj_housing = sj_housing.sort_values("date")
sj_housing = sj_housing.set_index("date")
sj_housing.head()


sj_housing.to_csv("../data/processed/sj_housing_final.csv")



