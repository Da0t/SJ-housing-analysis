import pandas as pd
import matplotlib.pyplot as plt
from statsmodels.tsa.arima.model import ARIMA

ts_data = sj_housing.copy()

# make sure index is datetime
if 'date' in ts_data.columns:
    ts_data['date'] = pd.to_datetime(ts_data['date'])
    ts_data = ts_data.sort_values('date').set_index('date')
else:
    ts_data.index = pd.to_datetime(ts_data.index)
    ts_data = ts_data.sort_index()

# build monthly series on month-end frequency
rent_series = ts_data['rent_burden'].asfreq('ME')

# fill any missing months smoothly
rent_series = rent_series.interpolate(method='time')

# fit model
model = ARIMA(rent_series, order=(1, 1, 0))
results = model.fit()

# forecast next 24 months
forecast_steps = 24
forecast_values = results.forecast(steps=forecast_steps)

future_index = pd.date_range(
    start=rent_series.index[-1] + pd.offsets.MonthEnd(1),
    periods=forecast_steps,
    freq='ME'
)

forecast_series = pd.Series(forecast_values.values, index=future_index)

# plot
plt.figure(figsize=(12, 6))
plt.plot(rent_series.index, rent_series, label='Observed Rent Burden')
plt.plot(forecast_series.index, forecast_series, '--', label='Forecast')
plt.axhline(0.30, linestyle='--', color='gray', label='30% Affordability Threshold')

plt.title("Forecasted Rent Burden in Santa Clara County")
plt.xlabel("Year")
plt.ylabel("Rent Burden (Share of Income)")
plt.legend()
plt.show()

